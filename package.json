{
  "name": "surround-theatre",
  "displayName": "Surround Theatre",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Surround Theatre is a media player with Spatial Audio support.",
  "scripts": {
    "build": "node scripts/build.js",
