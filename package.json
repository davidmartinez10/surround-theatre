    "clean": "node scripts/clean.js",
    "compile": "node scripts/compile.js",
    "start": "node scripts/dev-build.js",
    "dev:browser": "BUILD_DIRECTORY=dist npx vite --config vite.browser.config.ts",
    "dev-hmr": "node scripts/dev-hmr.js",
    "make": "node scripts/make.js",
    "package": "node scripts/package.js",
    "patch-codecs": "nwts-patch-codecs"
  },
  "license": "MIT",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "1.4.1",
    "@lightrabbit/cue-parser": "^0.0.4",
    "@types/chrome": "^0.0.197",
    "@types/node": "^18.19.80",
    "@types/nw.js": "^0.13.21",
    "@types/pouchdb": "^6.4.2",
    "@types/pouchdb-browser": "^6.1.5",
    "ffmpeg-static": "5.2.0",
    "nw": "0.79.1-sdk",
    "nwts-tools": "^0.5.3",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-browser": "^9.0.0",
    "solid-js": "^1.5.1",
    "typescript": "^4.8.2",
    "vite": "^3.0.9",
    "vite-plugin-solid": "^2.3.0",
    "ws": "^8.18.3",
    "xel": "0.33.13"
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffprobe-installer/darwin-x64",
      "esbuild",
      "ffmpeg-static",
      "nw",
      "nwts-tools"
    ]
  },
  "bundleDependencies": [
